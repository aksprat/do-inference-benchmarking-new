# DigitalOcean Gradient AI - Serverless Inference
# Create a Model Access Key in the DigitalOcean Control Panel (Gradient AI
# Platform). Docs and the full model list:
# https://docs.digitalocean.com/products/inference/details/models/
DO_MODEL_ACCESS_KEY=

# Optional override (defaults to the public Serverless Inference endpoint)
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
